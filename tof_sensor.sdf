<?xml version="1.0" encoding="UTF-8"?>
<!-- tof_sensor -->
<!-- VL53L0X ToF sensor for Duckiedrone DD24-B -->
<sdf version="1.9">
    <model name="tof_sensor">
        <link name="tof_sensor_link">

        <inertial>
            <mass>0.01</mass>
            <inertia>
                <ixx>0.00001</ixx> <ixy>0</ixy> <ixz>0</ixz>
                <iyy>0.00001</iyy> <iyz>0</iyz> <izz>0</izz>
            </inertia>
        </inertial>

        <visual name="visual">
            <geometry>
                <box>
                    <size>0.006 0.02 0.02</size>
                </box>
            </geometry>
        </visual>

        
        <sensor name="tof" type="ray"> <!-- Lidar sensor-->
            <always_on>true</always_on>
            <update_rate>20</update_rate>
            <visualize>true</visualize> <!--Lasers visible in Gazebo-->
            <ray>
                <scan>
                     <horizontal>
                        <samples>1</samples>
                        <resolution>1</resolution>
                        <min_angle>0</min_angle>        <!-- Stationary -->
                        <max_angle>0</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.05</min>
                    <max>2.0</max> <!--Duckiedrone DD24-B has range of 0.05 to 2.0 meters-->
                    <resolution>0.01</resolution>
                </range>
            </ray>
        </sensor>
    </link>
</model>
</sdf>
